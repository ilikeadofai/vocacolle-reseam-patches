<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="menu_title">Reseam パッチ</string>

    <string name="section_ads">広告とプレミアム案内</string>
    <string name="hide_app_open_ads">起動時広告を非表示</string>
    <string name="hide_app_open_ads_summary">アプリの起動・復帰時に表示される全画面広告をスキップします。</string>
    <string name="hide_display_ads">バナー・フィード広告を非表示</string>
    <string name="hide_display_ads_summary">ホーム、検索、ライブラリ、プレイリストの広告を読み込みません。</string>
    <string name="skip_audio_ads">音声広告をスキップ</string>
    <string name="skip_audio_ads_summary">曲間の音声広告・ネットワーク広告を再生せずに次の曲へ進みます。</string>
    <string name="hide_premium_prompts">プレミアムのポップアップを非表示</string>
    <string name="hide_premium_prompts_summary">自動で表示されるプレミアム案内シートと、プレミアム限定機能のポップアップを非表示にします。プレミアム登録は設定から引き続き行えます。</string>
    <string name="section_metadata">楽曲情報</string>
    <string name="vocadb_titles">VocaDBの曲名を表示</string>
    <string name="vocadb_titles_summary">プレイヤーで、ニコニコ動画と完全に一致するVocaDBの英語またはローマ字の曲名を表示します。プレイヤー内の各曲の動画IDがvocadb.netに送信され、結果は端末にキャッシュされます。</string>
    <string name="share_youtube">YouTubeのオリジナルでシェア</string>
    <string name="share_youtube_summary">作品をシェアするとき、そのニコニコ動画についてVocaDBに登録されたYouTubeのオリジナルがあれば、ニコニコのリンクの代わりに使います。まだ照会していない動画は照会を始め、次のシェアから反映されます。</string>
    <string name="section_ai">曲名の翻訳</string>
    <string name="ai_titles">曲名を翻訳</string>
    <string name="ai_titles_summary">プレイヤーの日本語の曲名を翻訳します。各曲名が下の翻訳サービスへ送信され、翻訳は端末にキャッシュされます。VocaDBの曲名がある曲は送信しません。</string>
    <string name="ai_descriptions">作品説明を翻訳</string>
    <string name="ai_descriptions_summary">作品説明の日本語部分を、リンクや書式はそのままに翻訳します。テキストは下の翻訳サービスへ送信されます。</string>
    <string name="ai_notices">お知らせを翻訳</string>
    <string name="ai_notices_summary">設定のお知らせのタイトルを下の翻訳サービスで翻訳し、本文はGoogle翻訳のページ翻訳で開きます。その際、本文のアドレスがGoogleに渡されます。</string>
    <string name="ai_language">翻訳先の言語</string>
    <string name="ai_language_ko">韓国語</string>
    <string name="ai_language_en">英語</string>
    <string name="ai_provider">翻訳サービス</string>
    <string name="ai_provider_google">Google翻訳（キー不要）</string>
    <string name="ai_provider_openai">OpenAI互換API（自分のキー）</string>
    <string name="ai_base_url">APIのベースURL</string>
    <string name="ai_base_url_summary">OpenAI互換サービス用：/chat/completions の手前までのエンドポイント（HTTPS）。</string>
    <string name="ai_model">モデル</string>
    <string name="ai_model_summary">OpenAI互換サービス用：プロバイダが指定するモデル名。</string>
    <string name="ai_api_key">APIキー</string>
    <string name="ai_api_key_summary">OpenAI互換サービス用。この端末に暗号化して保存され、設定のエクスポートには含まれません。</string>
    <string name="ai_api_key_hint">APIキー</string>
    <string name="ai_api_key_saved">APIキーを保存しました</string>
    <string name="ai_api_key_cleared">APIキーを削除しました</string>
    <string name="save">保存</string>
    <string name="remove">削除</string>
    <string name="cancel">キャンセル</string>
    <string name="section_lyrics">歌詞</string>
    <string name="external_lyrics">VocaDB・LRCLIBの歌詞</string>
    <string name="external_lyrics_summary">ボカコレに歌詞がないとき、または今月の歌詞の上限に達したときに、ニコニコ動画と完全に一致する曲のLRCLIBの同期歌詞、またはVocaDBの原文歌詞を表示します。動画IDはvocadb.netに、曲名はlrclib.netに送信されます。</string>
</resources>
