<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="menu_title">Reseam 패치</string>

    <string name="section_ads">광고 및 프리미엄 안내</string>
    <string name="hide_app_open_ads">앱 시작 광고 숨기기</string>
    <string name="hide_app_open_ads_summary">앱을 시작하거나 다시 열 때 나오는 전체 화면 광고를 건너뜁니다.</string>
    <string name="hide_display_ads">배너·피드 광고 숨기기</string>
    <string name="hide_display_ads_summary">홈, 검색, 라이브러리, 플레이리스트의 광고를 불러오지 않습니다.</string>
    <string name="skip_audio_ads">음성 광고 건너뛰기</string>
    <string name="skip_audio_ads_summary">곡 사이에 나오는 음성·네트워크 광고 없이 다음 곡을 재생합니다.</string>
    <string name="hide_premium_prompts">프리미엄 팝업 숨기기</string>
    <string name="hide_premium_prompts_summary">자동으로 뜨는 프리미엄 안내 시트와 프리미엄 전용 기능 팝업을 숨깁니다. 프리미엄 가입은 설정에서 계속 할 수 있습니다.</string>
    <string name="section_metadata">곡 정보</string>
    <string name="vocadb_titles">VocaDB 곡 제목 표시</string>
    <string name="vocadb_titles_summary">플레이어에서 해당 니코니코 동영상과 정확히 일치하는 VocaDB의 영어 또는 로마자 제목을 보여 줍니다. 플레이어에 있는 각 곡의 동영상 ID가 vocadb.net으로 전송되며, 결과는 기기에 캐시됩니다.</string>
    <string name="share_youtube">YouTube 원본 링크로 공유</string>
    <string name="share_youtube_summary">작품을 공유할 때, 해당 니코니코 동영상에 대해 VocaDB에 등록된 YouTube 원본이 있으면 니코니코 링크 대신 사용합니다. 아직 조회하지 않은 동영상은 조회를 시작하고, 다음 공유부터 적용됩니다.</string>
    <string name="section_ai">곡 제목 번역</string>
    <string name="ai_titles">곡 제목 번역</string>
    <string name="ai_titles_summary">홈, 검색, 랭킹, 플레이리스트, 플레이어 등 앱 전체의 일본어 곡 제목을 번역합니다. 제목은 여러 개씩 묶어 아래 번역 서비스로 전송되며, 번역은 기기에 캐시됩니다. VocaDB 제목이 있는 곡은 전송하지 않습니다.</string>
    <string name="ai_descriptions">작품 소개 번역 버튼</string>
    <string name="ai_descriptions_summary">작품 소개 아래에 번역 버튼을 추가해, 누르면 원문 자리에 번역을 보여 줍니다. 버튼을 누를 때만 소개 글이 아래 번역 서비스로 전송됩니다.</string>
    <string name="ai_tags">태그 번역</string>
    <string name="ai_tags_summary">작품 상세의 태그와 검색 화면의 인기 태그를 아래 번역 서비스로 번역해 보여 줍니다. 이때 태그가 번역 서비스에 전달됩니다. 태그를 누르면 여전히 일본어 원문 태그로 검색합니다.</string>
    <string name="ai_lyrics_romaji">가사 발음</string>
    <string name="ai_lyrics_romaji_summary">일본어 가사 각 줄 아래에 로마자 발음을 Google 번역으로 붙입니다. 이때 가사 줄이 Google에 전달됩니다. 보카코레 가사와 외부 가사 모두에 적용됩니다.</string>
    <string name="ai_lyrics_translation">가사 번역</string>
    <string name="ai_lyrics_translation_summary">일본어 가사 각 줄 아래에 아래 번역 서비스로 번역을 붙입니다. 이때 가사 줄이 번역 서비스에 전달됩니다. 원래 가사는 그대로 둡니다.</string>
    <string name="ai_notices">공지 번역</string>
    <string name="ai_notices_summary">설정의 공지 제목을 아래 번역 서비스로 번역하고, 공지 본문은 Google 번역 페이지 번역으로 엽니다. 이때 본문 주소가 Google에 전달됩니다.</string>
    <string name="ai_language">번역할 언어</string>
    <string name="ai_language_ko">한국어</string>
    <string name="ai_language_en">영어</string>
    <string name="ai_provider">번역 서비스</string>
    <string name="ai_provider_google">Google 번역 (키 필요 없음)</string>
    <string name="ai_provider_openai">OpenAI 호환 API (내 키)</string>
    <string name="ai_base_url">API 기본 URL</string>
    <string name="ai_base_url_summary">OpenAI 호환 서비스용: /chat/completions 앞까지의 엔드포인트 (HTTPS).</string>
    <string name="ai_model">모델</string>
    <string name="ai_model_summary">OpenAI 호환 서비스용: 제공자가 요구하는 모델 이름.</string>
    <string name="ai_api_key">API 키</string>
    <string name="ai_api_key_summary">OpenAI 호환 서비스용. 이 기기에 암호화되어 저장되며, 설정 내보내기에 포함되지 않습니다.</string>
    <string name="ai_api_key_hint">API 키</string>
    <string name="ai_api_key_saved">API 키를 저장했습니다</string>
    <string name="ai_api_key_cleared">API 키를 삭제했습니다</string>
    <string name="save">저장</string>
    <string name="remove">삭제</string>
    <string name="cancel">취소</string>
    <string name="section_lyrics">가사</string>
    <string name="external_lyrics">다른 출처의 가사</string>
    <string name="external_lyrics_summary">보카코레에 가사가 없거나 가사를 표시하지 못할 때, VocaDB로 찾은 해당 니코니코 동영상의 곡 가사를 아래 출처에서 가져와 보여 줍니다. 동영상 ID는 vocadb.net으로, 곡 이름과 프로듀서는 각 출처로 전송됩니다.</string>
    <string name="ai_language_auto">앱 언어와 같게 (한국어 또는 영어)</string>
    <string name="translate">번역</string>
    <string name="translating">번역 중…</string>
    <string name="translated_description">번역된 작품 소개</string>
    <string name="translation_failed">작품 소개를 번역하지 못했습니다. 연결과 번역 서비스를 확인한 뒤 다시 시도해 주세요.</string>
    <string name="translation_not_set_up">먼저 Reseam 패치 화면에서 번역 서비스를 설정해 주세요.</string>
    <string name="close">닫기</string>
    <string name="lyrics_providers">가사 출처 (순서대로)</string>
    <string name="lyrics_providers_summary">쉼표로 구분해 순서대로 시도합니다: lrclib (LRCLIB), netease (NetEase Cloud Music), kugou (KuGou), vocadb (VocaDB, 싱크 없음).</string>
    <string name="show_original">원문 보기</string>
    <string name="section_ranking">랭킹</string>
    <string name="full_ranking">랭킹 전체 보기</string>
    <string name="full_ranking_summary">랭킹의 상위 100곡만이 아니라 모든 페이지(최대 300곡)를 보여 줍니다. 추가 페이지는 보카코레 자체 랭킹 서비스에서 받아 오며, 랭킹을 열 때 요청이 두 번 더 갑니다.</string>
    <string name="section_library">라이브러리</string>
    <string name="favorite_button">즐겨찾기 버튼</string>
    <string name="favorite_button_summary">작품 상세 화면에 이 기기의 즐겨찾기에 추가하거나 빼는 버튼을 보여 줍니다.</string>
    <string name="local_favorites">이 기기의 즐겨찾기</string>
    <string name="local_favorites_summary">이 기기에만 저장되는 곡 목록으로, 개수 제한이 없습니다. 아무것도 전송되지 않고 좋아요·마이리스트도 바뀌지 않습니다. 재생목록으로 재생하고, 텍스트로 내보내거나 가져올 수 있습니다.</string>
    <string name="favorite_add">☆ 즐겨찾기</string>
    <string name="favorite_remove">★ 즐겨찾기에서 빼기</string>
    <string name="favorite_added">이 기기의 즐겨찾기에 추가했습니다</string>
    <string name="favorite_removed">즐겨찾기에서 뺐습니다</string>
    <string name="favorites_title">즐겨찾기</string>
    <string name="favorites_empty">아직 즐겨찾기가 없습니다. 작품 상세 화면의 ☆ 즐겨찾기 버튼으로 곡을 추가하세요.</string>
    <string name="favorites_more">내보내기·가져오기</string>
    <string name="favorites_more_summary">내보내기는 목록을 텍스트로 복사하고 공유 화면을 엽니다. 가져오기는 내보낸 목록에서 아직 없는 곡을 추가합니다.</string>
    <string name="favorites_play_all">전체 재생</string>
    <string name="favorites_play_from_here">여기부터 재생</string>
    <string name="favorites_open_failed">보카코레에서 재생목록을 열지 못했습니다.</string>
    <string name="favorites_export">내보내기</string>
    <string name="favorites_import">가져오기</string>
    <string name="favorites_import_hint">내보낸 목록을 붙여 넣으세요</string>
    <string name="favorites_import_failed">내보낸 즐겨찾기 목록이 아닙니다.</string>
    <string name="favorites_imported">%d곡을 추가했습니다</string>
    <string name="favorites_copied">목록을 복사했습니다</string>
